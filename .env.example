# Copy to .env and replace every /path/to/... value locally.
# Do not commit .env. The public scripts refuse placeholder paths.

REPO_ROOT=/path/to/emostable_tts_public
PYTHON_BIN=python
CUDA_VISIBLE_DEVICES=0

LLM_PATH=/path/to/Qwen2.5-1.5B
CODEC_DECODER_PATH=/path/to/CosyVoice-300M-SFT
BASE_CKPT=/path/to/base/model.pt
INFERENCE_CKPT=/path/to/finetuned/model.pt

TRAIN_DATA_PATH=/path/to/train.jsonl
VAL_DATA_PATH=/path/to/val.jsonl
OUTPUT_DIR=/path/to/outputs/emovoice-stability
DECODE_LOG=/path/to/outputs/emovoice-stability/inference

USE_WANDB=false
WANDB_ENTITY=
WANDB_PROJECT=emovoice-stability
